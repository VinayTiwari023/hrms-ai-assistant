# Application Configuration
APP_NAME=HRMS AI Assistant
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM & Embedding Settings (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120.0
OLLAMA_EMBED_DIMENSION=768
OLLAMA_ENABLE_THINKING=false

# Embedding Subsystem
# Options: "ollama" (live Ollama service) or "mock" (offline deterministic testing)
EMBEDDING_PROVIDER=ollama
EMBEDDING_TIMEOUT_SECONDS=30.0

# Conversational Orchestration Options
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_ROUNDS=3
CHAT_TOOL_TEMPERATURE=0.0
CHAT_FINAL_TEMPERATURE=0.2
CHAT_CONTEXT_LENGTH=4096
CHAT_MAX_OUTPUT_TOKENS=512

# Vector Database (Qdrant)
# VECTOR_STORE_TYPE: "qdrant"
VECTOR_STORE_TYPE=qdrant
# QDRANT_MODE: "local" (embedded file storage), "memory" (in-memory for testing), or "remote" (server cluster)
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./storage/qdrant
QDRANT_STORAGE_PATH=./storage/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=hrms_knowledge
QDRANT_COLLECTION=hrms_knowledge
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=4

# Document Chunking & Ingestion
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
MAX_CHUNK_SIZE_TOKENS=800
MAX_DOCUMENT_SIZE_BYTES=10485760
MAX_INGESTION_DOCUMENTS=100

# Persistence Database (SQLite)
DATABASE_URL=sqlite:///./storage/hrms_assistant.db

# HRMS Integration Mode
# Options: "mock" (built-in sample fictional dataset) or "http" (external REST API)
HRMS_ADAPTER_TYPE=mock
HRMS_API_BASE_URL=http://127.0.0.1:8080
HRMS_API_TIMEOUT_SECONDS=10.0
HRMS_MUTATIONS_ENABLED=false

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================================
# Phase 5 — Chat Orchestration Configuration
# ============================================================

# Ollama Chat Model (must be installed in Ollama)
# OLLAMA_CHAT_MODEL=qwen3:4b  (already set above)

# Maximum conversation history turns retained in context
# CHAT_MAX_HISTORY_TURNS=10  (already set above)

# Maximum tool-calling iterations per request
# CHAT_MAX_ROUNDS=3  (already set above)

# Maximum user message length (characters)
CHAT_MAX_MESSAGE_LENGTH=4000

# Maximum tool calls per single chat request
CHAT_MAX_TOOLS_PER_REQUEST=9

# Enable greeting fast-path (skips Ollama for simple greetings)
CHAT_GREETING_FAST_PATH=true

# Ollama inference timeout in seconds
# OLLAMA_TIMEOUT_SECONDS=120.0  (already set above)

# ============================================================
# Phase 6 — Streaming & Operational Hardening Configuration
# ============================================================

# Enable automated context summarization for long conversations
CHAT_SUMMARIZATION_ENABLED=true

# Dialogue turns threshold before triggering summarization
CHAT_SUMMARIZATION_THRESHOLD_TURNS=10

# Maximum summary token budget
CHAT_SUMMARY_MAX_TOKENS=256

# Optional dedicated model for summarization (blank defaults to OLLAMA_CHAT_MODEL)
CHAT_SUMMARY_MODEL=

# Streaming chat request timeout in seconds
CHAT_STREAMING_TIMEOUT_SECONDS=120.0

# Estimated maximum context window tokens
CHAT_MAX_CONTEXT_TOKENS=4096
